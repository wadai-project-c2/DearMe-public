{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOnlyDearMeLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:000000000000:log-group:/aws/lambda/dearme-api-dev:*"
    },
    {
      "Sid": "ReadOnlyDearMeBackendSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-northeast-1:000000000000:secret:dearme/dev/backend-??????"
    }
  ]
}
